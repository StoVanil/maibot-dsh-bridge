[plugin]
enabled = true
config_version = "0.6.1"

[dsh]
# dsh 可执行命令（装好后通常是 dsh；Windows 全局装可能在 C:\nodejs\dsh.cmd）
command = "dsh"
# 固定附加参数；桥会自动追加 --json
extra_args = "--profile headless"
# dsh 工作目录；留空则用插件 data 目录下的 workspace/<stream>
workspace_dir = ""
# 超时：dsh 在规划轮自报时长，这里只给夹取范围与默认建议值
timeout_default = 300
timeout_min = 60
timeout_max = 1800
# 无进展心跳：输出/进程CPU/子进程三信号全静超过此秒数即判卡死
heartbeat_seconds = 180
# 重复检测：同一行连续出现达到此次数即判循环
repeat_threshold = 25
# 温和终止后的宽限等待（秒），超时才强杀进程树
grace_seconds = 15
# 文本回退时最大字符数
max_output_chars = 8000
# 合并转发最多节点数 / 单节点最大字符数
max_forward_nodes = 40
node_max_chars = 1500
# 回传形态：forward=合并转发 / text=纯文本
display_mode = "forward"
# 回灌进麦麦上下文的结果摘要上限（越小越省上下文）
context_inject_chars = 600
# 单次任务最多打包发送的交付物数量
deliver_max_files = 8
# 是否允许 dsh 经 schedule-requests 自建定时任务（关则禁止，风险自负）
allow_self_schedule = true
# 存放 API Key 的环境变量名
api_key_env = "DEEPSEEK_API_KEY"
# DeepSeek API Key（明文；留空则用系统环境变量；勿分享本文件）
api_key = ""
# dsh 沙箱权限模式：danger-full-access（默认，git clone / npm 等依赖子进程管道的命令可用）
# workspace-write / read-only 更严，但 Windows ACL 沙箱会拦住 git 的命名管道，导致 clone 失败
permission_mode = "danger-full-access"

[permission]
enabled = true
# 名单模式：whitelist=仅名单内可用（默认，安全）；blacklist=名单内不可用、其余放行
mode = "whitelist"
# 白名单用户 ID，逗号分隔；白名单模式下留空则拒绝所有人（fail-closed）
allowed_users = ""
# 白名单群 ID，逗号分隔；群聊里取不到发言人 ID 时作为兜底
allowed_groups = ""
# 黑名单用户 / 群 ID，逗号分隔；仅 mode = "blacklist" 时生效
blocked_users = ""
blocked_groups = ""
# 是否对 dsh_run / schedule_* 工具也施加名单（关=工具面放开，风险自负）
enforce_tools = true
