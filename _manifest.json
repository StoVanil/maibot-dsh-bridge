{
  "manifest_version": 2,
  "id": "ji-or-ji.maibot-dsh-bridge",
  "version": "0.12.0",
  "name": "麦麦×dsh 桥",
  "description": "把 DeepSeek Harness (大肥鱼) 接入麦麦：话题制会话（/大肥鱼 统一指令）、持久会话、独立工作区、大肥鱼 提问（MCP ask，同一进程继续）、QQ 发文件给 大肥鱼、present 交付文件回传、Office 文档技能、定时任务；/大肥鱼 stop 停止、/大肥鱼 peek 看进展；实验功能：设置里临时开启 24h 后墨可自主调度。基于 ji-or-ji/maibot-大肥鱼-bridge 的派生版本。",
  "author": {
    "name": "ji-or-ji",
    "url": "https://github.com/ji-or-ji"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/<YOUR_GITHUB>/maibot-dsh-bridge",
    "homepage": "https://github.com/<YOUR_GITHUB>/maibot-dsh-bridge",
    "documentation": "https://github.com/<YOUR_GITHUB>/maibot-dsh-bridge/blob/main/README.md",
    "issues": "https://github.com/<YOUR_GITHUB>/maibot-dsh-bridge/issues"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.forward",
    "api.call",
    "api.get",
    "maisaka.context.append"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
